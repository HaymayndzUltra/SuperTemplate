{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-classification.schema.json",
  "title": "Project Classification",
  "description": "Schema for the output of classify_project_type.py",
  "type": "object",
  "required": ["timestamp", "classification", "confidence_score", "confidence_level"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "classification": {
      "type": "string",
      "enum": ["ai_ml_application", "generic_web_app", "hybrid_application", "api_microservice", "data_pipeline", "mobile_application", "other"],
      "description": "Project classification type"
    },
    "classification_display": {
      "type": "string",
      "description": "Human-readable classification name"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence score as percentage"
    },
    "confidence_level": {
      "type": "string",
      "enum": ["high", "medium", "low", "very_low"],
      "description": "Confidence level category"
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": {"type": "number"},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      },
      "description": "Scores for each classification type"
    },
    "input_files": {
      "type": "object",
      "properties": {
        "brief": {"type": "string"},
        "architecture": {"type": ["string", "null"]}
      },
      "description": "Input file paths"
    }
  }
}

