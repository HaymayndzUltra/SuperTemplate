{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-manifest.schema.json",
  "title": "Evidence Manifest",
  "description": "Schema for the evidence-manifest.json output of package_evidence.py",
  "type": "object",
  "required": ["manifest_version", "protocol", "generated", "artifacts", "summary", "integrity"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the manifest format"
    },
    "protocol": {
      "type": "string",
      "description": "Protocol ID that generated this manifest"
    },
    "protocol_name": {
      "type": "string",
      "description": "Human-readable protocol name"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of generation"
    },
    "workspace": {
      "type": "string",
      "description": "Workspace path"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "full_path": {"type": "string"},
          "size_bytes": {"type": "integer"},
          "modified": {"type": "string", "format": "date-time"},
          "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "required": ["name", "path", "size_bytes", "hash"]
      },
      "description": "List of artifacts in the package"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_artifacts": {"type": "integer"},
        "total_size_bytes": {"type": "integer"},
        "artifact_types": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        }
      },
      "required": ["total_artifacts", "total_size_bytes"]
    },
    "integrity": {
      "type": "object",
      "properties": {
        "hash_algorithm": {"type": "string"},
        "verified": {"type": "boolean"},
        "signature": {"type": "string"}
      },
      "required": ["hash_algorithm", "verified"]
    }
  }
}

